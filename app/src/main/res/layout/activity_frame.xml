<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_border"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/image_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/image_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <VideoView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/clock_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="32dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#99000000"
                android:shadowRadius="12"
                android:textColor="@color/otium_text"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#99000000"
                android:shadowRadius="10"
                android:textColor="@color/otium_sub"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="24dp"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/ambient_chip"
            style="@style/OtiumChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="96dp"
            android:layout_marginEnd="24dp"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/swatch"
            android:gravity="center_vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/idle_hint"
            style="@style/OtiumChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/idle_hint"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dismiss_hint"
            style="@style/OtiumChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:text="@string/dismiss_hint" />

        <!-- 오른쪽 아래: 화면 자동 전환 on/off (켜면 P기어 감지 서비스 실행, 끄면 중단) -->
        <LinearLayout
            android:id="@+id/auto_switch_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:background="@drawable/chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/auto_switch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/auto_switch"
                android:textColor="@color/otium_text"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/auto_switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="@string/auto_switch"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track" />
        </LinearLayout>

        <Button
            android:id="@+id/demo_toggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="24dp"
            android:text="@string/demo"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/demo_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="84dp"
            android:background="@drawable/chip_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/demo_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/otium_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/demo_p" style="@style/DemoButton" android:text="@string/demo_gear_p" />
                <Button android:id="@+id/demo_r" style="@style/DemoButton" android:text="@string/demo_gear_r" />
                <Button android:id="@+id/demo_n" style="@style/DemoButton" android:text="@string/demo_gear_n" />
                <Button android:id="@+id/demo_d" style="@style/DemoButton" android:text="@string/demo_gear_d" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/demo_brake" style="@style/DemoButton" />
                <Button android:id="@+id/demo_charge" style="@style/DemoButton" />
                <Button android:id="@+id/demo_ambient" style="@style/DemoButton" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
